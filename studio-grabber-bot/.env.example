# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Кто может пользоваться ботом (Telegram user id через запятую). Пусто = все.
ALLOWED_USER_IDS=

# --- Google Drive ---
# ID папки студии (часть URL: drive.google.com/drive/folders/<ЭТО_ID>)
GDRIVE_FOLDER_ID=
# Путь к JSON-ключу сервисного аккаунта
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Делать ссылку публичной (доступ "всем, у кого есть ссылка")
MAKE_PUBLIC=true
# Раскладывать по подпапкам с датой (ГГГГ-ММ-ДД).
# Для копилки референсов держим false — всё в одну папку.
DATE_SUBFOLDERS=false

# --- Прочее ---
# Временная папка для скачивания
DOWNLOAD_DIR=/tmp/studio-grabber
